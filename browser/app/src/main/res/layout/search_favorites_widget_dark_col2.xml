
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    style="@style/SearchWidgetContainer"
    android:background="@drawable/search_widget_favorites_dark_background">

    <include
        layout="@layout/search_favorites_widget_search_bar_dark"/>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <GridView
            android:id="@+id/emptyfavoritesGrid"
            style="@style/SearchWidgetFavoritesGrid"
            android:numColumns="2" />

        <GridView
            android:id="@+id/favoritesGrid"
            style="@style/SearchWidgetFavoritesGrid"
            android:numColumns="2" />

    </FrameLayout>
</LinearLayout>