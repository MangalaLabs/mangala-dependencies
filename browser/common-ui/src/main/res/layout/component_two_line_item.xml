<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingStart="@dimen/keyline_4"
    android:paddingTop="@dimen/keyline_5"
    android:paddingEnd="@dimen/keyline_4"
    android:paddingBottom="@dimen/keyline_5">

    <com.mangala.mobile.android.ui.view.SectionHeaderTextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Two Line Item"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.mangala.mobile.android.ui.view.TwoLineListItem
        android:id="@+id/twoLineListItemWithImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:twoLineItemTitle="Title"
        app:twoLineItemSubtitle="Two line item with image"
        app:twoLineItemDrawable="@drawable/ic_globe_gray_16dp"
        app:twoLineItemImageVisible="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/label"/>

    <com.mangala.mobile.android.ui.view.TwoLineListItem
        android:id="@+id/twoLineListItemWithoutImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:twoLineItemTitle="Title"
            app:twoLineItemSubtitle="Two line item without image"
            app:twoLineItemImageVisible="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/twoLineListItemWithImage"/>

</androidx.constraintlayout.widget.ConstraintLayout>