<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance"/>
    <style name="TextAppearance.Mangala">
        <item name="android:textColor">?attr/normalTextColor</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <!-- Migrate colors to ?attr/primaryTextColor once the migration is done -->
    <style name="TextAppearance.Mangala.Headline1">
        <item name="android:textSize">32sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Mangala.Headline2">
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Mangala.Headline3">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">5sp</item>
    </style>

    <style name="TextAppearance.Mangala.Headline4">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">5sp</item>
    </style>

    <style name="TextAppearance.Mangala.Headline5">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">5sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Mangala.Headline6">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>

    <style name="TextAppearance.Mangala.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="TextAppearance.Mangala.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>

    <style name="TextAppearance.Mangala.Button1">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>

    <style name="TextAppearance.Mangala.Button2">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:letterSpacing">0.8</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Mangala.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

</resources>