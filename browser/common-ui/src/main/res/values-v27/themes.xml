<?xml version="1.0" encoding="utf-8"?>


<resources>

    <style name="BaseAppTheme" parent="Theme.MaterialComponents.Light.Bridge">
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="AppTheme3.Dark" parent="AppTheme3.BaseDark">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">?toolbarBgColor</item>
    </style>

    <style name="AppTheme3.Light" parent="AppTheme3.BaseLight">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

</resources>
